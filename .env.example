# OpenAI API key for the AI assistant (gpt-4o-mini)
OPENAI_API_KEY=

# Secret used to sign JWTs. Do not leave empty. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Optional. Leave empty to try local PostgreSQL
# (postgresql+psycopg2://postgres:postgres@localhost:5432/cinevault) and fall back to SQLite.
# Examples:
#   DATABASE_URL=sqlite:///./cinevault.db
#   DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/cinevault
DATABASE_URL=

# Admin account created on first start (only if the username does not exist yet).
# Do not leave ADMIN_PASSWORD empty: an empty value is used as-is.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
